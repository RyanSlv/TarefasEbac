<?xml version="1.0" encoding="UTF-8"?>

<persistence version="3.0"
    xmlns="https://jakarta.ee/xml/ns/persistence"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
    https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="Postgre1" transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>br.com.ryans.domain.jpa.ClienteJpa</class>
        <class>br.com.ryans.domain.jpa.ProdutoJpa</class>
        <class>br.com.ryans.domain.jpa.VendaJpa</class>
        <class>br.com.ryans.domain.jpa.ProdutoQuantidadeJpa</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>

            <property name="jakarta.persistence.jdbc.driver"
                      value="org.postgresql.Driver" />

            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:postgresql://localhost:15432/vendas_online" />

            <property name="jakarta.persistence.jdbc.user"
                      value="postgres" />

            <property name="jakarta.persistence.jdbc.password"
                      value="admin" />

            <property name="hibernate.dialect"
                      value="org.hibernate.dialect.PostgreSQLDialect" />

            <property name="hibernate.hbm2ddl.auto"
                      value="update" />

            <property name="hibernate.show_sql"
                      value="true" />

            <property name="hibernate.format_sql"
                      value="true" />

        </properties>

    </persistence-unit>


    <persistence-unit name="Postgre2" transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>br.com.ryans.domain.jpa.ClienteJpa</class>
        <class>br.com.ryans.domain.jpa.ProdutoJpa</class>
        <class>br.com.ryans.domain.jpa.VendaJpa</class>
        <class>br.com.ryans.domain.jpa.ProdutoQuantidadeJpa</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>

            <property name="jakarta.persistence.jdbc.driver"
                      value="org.postgresql.Driver" />

            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:postgresql://localhost:15432/vendas_online_2" />

            <property name="jakarta.persistence.jdbc.user"
                      value="postgres" />

            <property name="jakarta.persistence.jdbc.password"
                      value="admin" />

            <property name="hibernate.dialect"
                      value="org.hibernate.dialect.PostgreSQLDialect" />

            <property name="hibernate.hbm2ddl.auto"
                      value="update" />

            <property name="hibernate.show_sql"
                      value="true" />

            <property name="hibernate.format_sql"
                      value="true" />

        </properties>

    </persistence-unit>


    <persistence-unit name="Mysql1" transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>br.com.ryans.domain.jpa.ClienteJpa2</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>

            <property name="jakarta.persistence.jdbc.driver"
                      value="com.mysql.cj.jdbc.Driver" />

            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://localhost:3306/vendas_online" />

            <property name="jakarta.persistence.jdbc.user"
                      value="root" />

            <property name="jakarta.persistence.jdbc.password"
                      value="admin" />

            <property name="hibernate.dialect"
                      value="org.hibernate.dialect.MySQLDialect" />

            <property name="hibernate.hbm2ddl.auto"
                      value="update" />

            <property name="hibernate.show_sql"
                      value="true" />

            <property name="hibernate.format_sql"
                      value="true" />

        </properties>

    </persistence-unit>

</persistence>